# Variable names only. Copy to .env and fill in; .env is git-ignored.
# DB_USER and DB_PASSWORD are required; the rest fall back to defaults in apps/api/src/config.ts.

# Postgres + pgvector (docker compose)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# API
API_PORT=
LOG_LEVEL=

# Providers
EMBED_PROVIDER=
CHAT_PROVIDER=
OLLAMA_URL=
EMBED_MODEL=
EMBED_USE_PREFIXES=
EMBED_HEADINGS=
CHAT_MODEL=
CHAT_THINK=
CHAT_NUM_CTX=

# CHAT_PROVIDER=openai (any OpenAI-compatible API)
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Reranker
RERANK_PROVIDER=
RERANK_MODEL=
RERANK_DTYPE=

# /ask
ASK_MIN_SCORE=
