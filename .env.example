# Copy to .env and adjust. Used by both docker compose and apps/api.

# --- Postgres + pgvector (docker compose) ---
# 5433 on the host, so it does not clash with a locally installed Postgres on 5432
DB_HOST=localhost
DB_PORT=5433
DB_USER=rag
DB_PASSWORD=rag
DB_NAME=rag

# --- API ---
API_PORT=3000
LOG_LEVEL=info

# --- Providers ---
# Which implementation backs the Embedder / Generator interfaces.
# Only "ollama" is implemented for now; "openai" / "claude" are planned stubs.
EMBED_PROVIDER=ollama
CHAT_PROVIDER=ollama

OLLAMA_URL=http://localhost:11434

# Embedding model: bge-m3 | nomic-embed-text | mxbai-embed-large
EMBED_MODEL=bge-m3
# Apply the model's query/document prefixes (nomic, mxbai). Toggle off to measure their effect.
EMBED_USE_PREFIXES=true

# Chat model for answers
CHAT_MODEL=qwen3:8b
# qwen3 is a "thinking" model; reasoning tokens are slow and not needed for grounded answers
CHAT_THINK=false

# Cross-encoder reranker for search candidates: transformers | none.
# Runs in-process (ONNX); the model (~0.6 GB for int8) is downloaded on first use into data/models/.
RERANK_PROVIDER=transformers
RERANK_MODEL=onnx-community/bge-reranker-v2-m3-ONNX
RERANK_DTYPE=int8
