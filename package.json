{
  "name": "nest-docs-rag",
  "private": true,
  "description": "Ask the NestJS docs: a local RAG over the official documentation — Ollama + Postgres/pgvector + React",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "smoke": "npm run smoke -w apps/api",
    "ingest": "npm run ingest -w apps/api --",
    "eval": "npm run eval -w apps/api --",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
