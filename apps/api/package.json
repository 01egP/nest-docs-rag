{
  "name": "@nest-docs-rag/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "smoke": "tsx src/scripts/smoke.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx src/scripts/eval.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pgvector": "^0.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
